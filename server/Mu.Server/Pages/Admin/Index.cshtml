@page "/admin"
@model Mu.Server.Pages.Admin.IndexModel
@{ ViewData["Title"] = "管理概览"; }
<h1>账户管理</h1>
<p class="muted">当前管理员：@User.Identity?.Name。管理会话有效期为 2 小时。</p>
<div class="grid">
    <a class="card" asp-page="/Admin/Users"><h2>用户 @Model.UserCount</h2><p>查询用户、调整会员、管理会话</p></a>
    <a class="card" asp-page="/Admin/Telemetry"><h2>游戏监控 @Model.TelemetryCount</h2><p>查看运行会话、FPS 覆盖与游戏、显卡分布</p></a>
    <a class="card" asp-page="/Admin/Features"><h2>功能权限 @Model.FeatureCount</h2><p>配置普通用户、Pro 和功能关闭</p></a>
    <a class="card" asp-page="/Admin/Orders"><h2>订单 @Model.OrderCount</h2><p>待核对 @Model.ReviewCount 笔</p></a>
    <a class="card" asp-page="/Admin/Mail"><h2>邮箱监控</h2><p>查询验证码发送、投递状态与失败原因</p></a>
</div>
<section class="card"><h2>@(Model.ManualPaymentAvailable ? "人工收款申请已开放" : "购买入口尚未开放")</h2>
<p>@(Model.ManualPaymentAvailable ? "收到付款核对申请后，请在收款平台确认实际到账，再到订单页开通会员。" : "上架套餐、至少一项真实 Pro 权益和服务器收款信息都准备好后，才能开放人工购买申请。")</p></section>
