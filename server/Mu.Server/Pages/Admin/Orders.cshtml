@page "/admin/orders"
@model Mu.Server.Pages.Admin.OrdersModel
@{ ViewData["Title"] = "订单查询"; }
<h1>订单查询</h1>
<p class="muted">仅在收款平台核对实际到账、金额与订单编号后确认。重复确认不会重复开通会员。</p>
<div asp-validation-summary="All" role="alert"></div>
<form method="get" class="row"><div><label asp-for="Search">完整订单 ID 或用户 ID</label><input asp-for="Search" maxlength="128" /></div><button type="submit">查询</button></form>
<div class="table-scroll"><table><thead><tr><th>订单</th><th>用户</th><th>套餐</th><th>金额</th><th>状态</th><th>时间</th><th>核对到账</th></tr></thead><tbody>
@foreach (var order in Model.Items)
{
    <tr><td><code>@order.Id</code></td><td>@Model.Emails.GetValueOrDefault(order.UserId, order.UserId)<br /><small>@order.UserId</small></td>
    <td>@order.PlanName<br /><small>@order.DurationDays 天</small></td><td>@order.Currency @((order.AmountMinor / 100m).ToString("0.00"))</td><td>@order.Status</td>
    <td><small>创建：@Mu.Server.Pages.Admin.AdminPageModel.FormatTime(order.CreatedAt)<br />确认：@Mu.Server.Pages.Admin.AdminPageModel.FormatTime(order.PaidAt)</small></td>
    <td>
    @if ((order.Status is "pending" or "review_requested") && order.Provider == "manual")
    {
        <form method="post" asp-page-handler="Confirm">
            <input type="hidden" name="OrderId" value="@order.Id" />
            <label>收款流水号<input name="PaymentReference" required minlength="4" maxlength="120" /></label>
            <label>核对说明<input name="Reason" required minlength="3" maxlength="500" /></label>
            <label><input name="ReceiptVerified" type="checkbox" value="true" required /> 我已核对到账、金额和订单编号</label>
            <button type="submit">确认到账并开通</button>
        </form>
    }
    else if (order.ProviderTransactionId is not null) { <code>@order.ProviderTransactionId</code> }
    </td></tr>
}
</tbody></table></div>
@if (Model.Items.Count == 0) { <p class="muted">暂无订单记录。</p> }
