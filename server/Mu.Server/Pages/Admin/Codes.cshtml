@page "/admin/codes"
@model Mu.Server.Pages.Admin.CodesModel
@{ ViewData["Title"] = "CDK 兑换码"; }
<h1>CDK 兑换码</h1>
<p class="muted">生成 Pro 会员兑换码，每码限用一次；已有会员从当前有效期续期。完整兑换码仅在生成后显示一次，请立即保存。</p>
<div asp-validation-summary="All" role="alert"></div>
@if (Model.Generated.Length > 0)
{
    <section class="card"><h2>本次生成的兑换码</h2>
        <p>请复制保存。刷新此页面会重新提交生成请求，请使用导航离开。</p>
        <textarea readonly rows="10" aria-label="本次生成的兑换码">@string.Join("\n", Model.Generated)</textarea>
    </section>
}
<section class="card"><h2>生成兑换码</h2>
    <form method="post" class="row">
        <div><label asp-for="DurationDays">会员天数</label><input asp-for="DurationDays" type="number" min="1" max="3650" required /></div>
        <div><label asp-for="Count">数量</label><input asp-for="Count" type="number" min="1" max="100" required /></div>
        <div><label asp-for="ValidDays">兑换有效期（天）</label><input asp-for="ValidDays" type="number" min="1" max="3650" required /></div>
        <div><label asp-for="Reason">操作原因</label><input asp-for="Reason" required minlength="3" maxlength="500" /></div>
        <button type="submit">生成兑换码</button>
    </form>
</section>
<h2>最近 100 个兑换码</h2>
@foreach (var item in Model.Items)
{
    var status = item.RedeemedAt != null ? "已兑换" : item.RevokedAt != null ? "已停用" : item.ExpiresAt <= DateTimeOffset.UtcNow.ToUnixTimeSeconds() ? "已过期" : "未兑换";
    <section class="card">
        <p>编号：@item.Id · @item.DurationDays 天 · @status</p>
        <p>生成：@Mu.Server.Pages.Admin.AdminPageModel.FormatTime(item.CreatedAt) · 兑换截止：@Mu.Server.Pages.Admin.AdminPageModel.FormatTime(item.ExpiresAt)</p>
        @if (item.RedeemedAt != null)
        {
            <p>兑换用户：@item.RedeemedBy · 兑换时间：@Mu.Server.Pages.Admin.AdminPageModel.FormatTime(item.RedeemedAt)</p>
        }
        @if (status == "未兑换")
        {
            <form method="post" asp-page-handler="Revoke" class="row">
                <input type="hidden" name="id" value="@item.Id" />
                <input name="Reason" aria-label="停用原因" placeholder="停用原因" required minlength="3" maxlength="500" />
                <button type="submit">停用兑换码</button>
            </form>
        }
    </section>
}
