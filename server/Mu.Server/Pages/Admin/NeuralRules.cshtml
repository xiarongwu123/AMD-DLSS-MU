@page "/admin/neural-rules"
@model Mu.Server.Pages.Admin.NeuralRulesModel
@{ ViewData["Title"] = "神经渲染兼容规则"; }
<h1>神经渲染兼容规则</h1>
<p>按游戏 ID（例如 steam:12345）、显卡系列和图形接口匹配。新智能推荐读取 smartRules，空规则仅显示未验证候选，不生成自动推荐。不得将启动成功标为稳定支持。</p>
<p>backend：daniel / lmxxf / mochizuki / lmxxf-rdna3（AMDNR RX 7000）。status：verified / community / experimental / unverified。gpuSeries：rx6000 / rx7000 / rx9000；graphicsApis：dx11 / dx12 / vulkan。</p>
<p>lmxxf-rdna3 的 smartRules 必须指定 scheme=compat、architectures=[rdna3]、bitness=64、componentVersion=0.3.5.8；依赖为 hip 与 amdnr-rdna3-package。此路线不可使用原宿主的 Inline、提前包装或增强屏障参数。发布给新客户端前请保持旧客户端规则兼容。</p>
<p>修改 revision，并将 expiresUtc 设在未来 30 天内。规则不允许指定下载 URL、任意 INI 键或命令；历史版本保存在服务器规则文件旁的 .history 目录。</p>
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input asp-for="Revision" type="hidden" />
    <label asp-for="Document">规则 JSON</label>
    <textarea asp-for="Document" rows="24" spellcheck="false" style="width:100%;font-family:monospace"></textarea>
    <label asp-for="Reason">发布原因 / 验证依据</label><input asp-for="Reason" maxlength="500" required />
    <button type="submit">校验并发布规则</button>
</form>

<h2>智能推荐扩展</h2>
<p>同一文档可增加 smartRules 与 weights；精确匹配 gameId、buildHashes/gameVersions、gpuModels/deviceIds/architectures、Windows 驱动范围、api、bitness 和固定 componentVersion。规则只允许结构化参数，不接受任意 INI、脚本或下载地址。社区统计由实际监控记录生成，不能手填。</p>
<p>依赖和高级参数请参阅仓库 docs/SMART-RECOMMENDATION.md。禁用规则设置 disabled=true；明确拒绝设置 deny=true。修改版本与验证时间需有真实依据，回滚不会刷新历史验证时间。</p>
@if(Model.History.Length>0){
<h2>回滚历史规则</h2><form method="post" asp-page-handler="Rollback"><input name="Revision" value="@Model.Revision" type="hidden"/>
<label>历史快照（恢复该次发布前的规则）<select name="HistoryId">@foreach(var id in Model.History){<option value="@id">@id</option>}</select></label>
<label>回滚原因<input name="Reason" required minlength="3" maxlength="500"/></label><button type="submit">校验并回滚</button></form>
}
