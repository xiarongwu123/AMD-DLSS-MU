Auth__CodePepper=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
Registration__Enabled=false
Email__Provider=resend
# For the isolated SMTP container, select smtp and configure:
# Smtp__Host=mu-smtp
# Smtp__Port=587
# Smtp__From=MU <noreply@smtp.claude-api.cn>
# Smtp__StartTls=false
# Smtp__AllowPrivatePlaintext=true
# For an external SMTP relay use StartTls=true and configure Username/Password.
Resend__ApiKey=
Resend__From=MU <noreply@mu-mail.claude-api.cn>
AllowedHosts=mu-api.claude-api.cn;localhost;127.0.0.1
