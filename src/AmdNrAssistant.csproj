<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AMD-DLSS-MU</AssemblyName>
    <Version>2.2.4</Version>
    <AssemblyVersion>2.2.4.0</AssemblyVersion>
    <FileVersion>2.2.4.0</FileVersion>
    <InformationalVersion>2.2.4</InformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/amd-dlss-mu.ico</ApplicationIcon>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
      <WebView2UseWinRT>false</WebView2UseWinRT>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../assets/amd-dlss-mu.ico" LogicalName="AmdNrAssistant.AppIcon" />
    <EmbeddedResource Include="..\assets\wechat-xrwCoder.jpg" LogicalName="AmdNrAssistant.WeChatQr" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <EmbeddedResource Include="..\assets\AMD-DLSS-MU.addon64" LogicalName="AmdNrAssistant.LivePanel" />
    <EmbeddedResource Include="..\native\LICENSE-Swapper" LogicalName="Licenses.DLSS5-Swapper" />
    <EmbeddedResource Include="..\native\LICENSE-SharpCompress.txt" LogicalName="Licenses.SharpCompress" />
    <EmbeddedResource Include="..\native\vendor\LICENSE-ReShade.md" LogicalName="Licenses.ReShade" />
    <EmbeddedResource Include="..\native\vendor\LICENSE-ImGui.txt" LogicalName="Licenses.ImGui" />
    <EmbeddedResource Include="../desktop-ui/src/reactbits/LICENSE.md" LogicalName="Licenses.ReactBits" />
    <EmbeddedResource Include="../assets/AMDNR-integration-NOTICE.txt" LogicalName="Licenses.AMDNR" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\assets\nvngx_dlssnr.dll" LogicalName="AmdNrAssistant.nvngx_dlssnr.dll" />
  </ItemGroup>
  <Target Name="RequireBundledDlssDll" BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('..\assets\nvngx_dlssnr.dll')"
           Text="缺少 assets/nvngx_dlssnr.dll，已停止构建：发布版必须内置模式一 DLL。" />
  </Target>
  <ItemGroup Condition="Exists('..\assets\amd_dlss_mu_logo.png')">
    <EmbeddedResource Include="..\assets\amd_dlss_mu_logo.png" LogicalName="AmdNrAssistant.amd_dlss_mu_logo.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\assets\mu-hero-art.png" LogicalName="AmdNrAssistant.mu-hero-art.png" />
    <EmbeddedResource Include="..\assets\mu-home-banner-new.png" LogicalName="AmdNrAssistant.mu-home-banner-new.png" />
    <EmbeddedResource Include="..\assets\mu-add-game-art.png" LogicalName="AmdNrAssistant.mu-add-game-art.png" />
    <EmbeddedResource Include="..\assets\mu-account-art.png" LogicalName="AmdNrAssistant.mu-account-art.png" />
    <EmbeddedResource Include="..\assets\mu-wish-pool-hero.png" LogicalName="AmdNrAssistant.mu-wish-pool-hero.png" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../desktop-ui/dist/**/*" Exclude="../desktop-ui/dist/artwork/**/*" LogicalName="ReactUI/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireReactUI" BeforeTargets="AssignTargetPaths">
    <Error Condition="!Exists('../desktop-ui/dist/index.html')" Text="缺少 React 构建，请先在 desktop-ui 运行 npm ci 与 npm run build。" />
  </Target>
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
  <ItemGroup><EmbeddedResource Include="../assets/x86-bridge-pins.json" LogicalName="Mu.X86Bridge.Pins" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../assets/x86-bridge-LICENSE.txt" LogicalName="Licenses.X86Bridge" /></ItemGroup>
<ItemGroup><EmbeddedResource Include="../assets/neural-rendering-1.12.1.json" LogicalName="Mu.NeuralRendering.Pins" />
<EmbeddedResource Include="../assets/amdnr-rdna3-0.3.5.8.json" LogicalName="Mu.AmdNrRdna3.Pins" /></ItemGroup></Project>
