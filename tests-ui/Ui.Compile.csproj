<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile the Windows UI on non-Windows hosts without packaging game payloads. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AmdNrAssistant</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/*.cs" Link="%(Filename)%(Extension)" />
    <PackageReference Include="SharpCompress" Version="0.48.1" />
  </ItemGroup>
</Project>
